# 1. Copy this file and rename the copy to exactly:  .env
# 2. Paste your real key after the = sign (no quotes, no spaces)
# 3. NEVER commit the .env file or share it with anyone (including me)

GEMINI_API_KEY=paste_your_key_here

# Which Gemini model to use. If Google retires it, visit /api/models to see valid options.
GEMINI_MODEL=gemini-3.8-flash

# Optional: port the server runs on
PORT=3000

# --- Backup provider (optional but recommended) ---
# Used automatically ONLY when Gemini is rate-limited, down, or refuses a photo.
OPENROUTER_API_KEY=paste_your_openrouter_key_here
OPENROUTER_MODEL=thinkingmachines/inkling:free
